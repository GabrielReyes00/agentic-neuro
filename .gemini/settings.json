{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "name": "agentic-neuro-memory-inject",
            "type": "command",
            "command": "cd /Users/gabrielreyes/agentic-neuro && source .venv/bin/activate && python3 src/precompact_memory_inject.py",
            "timeout": 60000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "name": "agentic-neuro-auto-close",
            "type": "command",
            "command": "cd /Users/gabrielreyes/agentic-neuro && source .venv/bin/activate && python3 src/auto_session_close.py",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
