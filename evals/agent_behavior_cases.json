        "mutation_policy": "read_only",
        "memory_policy": "learner_memory"
      },
      "rubric": "After silent startup, the first learner-facing response is exactly one focused question."
    },
    {
      "id": "operative-rehearsal",
      "prompt": "Build me an operative rehearsal guide for a retrosigmoid vestibular schwannoma resection.",
