      "rubric": "Treat the no-change clause as a strict approval gate."
    },
    {
      "id": "service-teaching",
      "prompt": "Capture what the chief taught me today on tumor service and keep local MDA conventions separate.",
      "expected": {
        "route": "service-log",
        "response_shape": "artifact_workflow",
        "evidence_policy": "proportional",
        "mutation_policy": "requested_artifact",
        "memory_policy": "service_isolated"
      },
      "rubric": "Route through shift debrief while preserving service and site provenance."
    },
    {
      "id": "journal-club-deck",
      "prompt": "Turn this assigned trial PDF into a journal club slide deck.",
      "expected": {
        "route": "grand-rounds",
        "response_shape": "artifact_workflow",
        "evidence_policy": "current_primary",
        "mutation_policy": "requested_artifact",
        "memory_policy": "none"
      },
      "rubric": "A slide request selects grand-rounds rather than the dossier-only journal-club path."
    }
