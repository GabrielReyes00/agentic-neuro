{
  "schema_version": 1,
  "route_cases": [
    {
      "id": "broad-clinical-management",
      "prompt": "Teach me how to manage spontaneous intracerebral hemorrhage from presentation through escalation and follow-up.",
      "expected": {
        "route": "clinical-answer",
        "response_shape": "comprehensive_teaching",
        "evidence_policy": "current_primary",
        "mutation_policy": "read_only",
        "memory_policy": "none"
      },
      "rubric": "Use the Clinical Answer Doctrine; do not misroute a broad teaching request to consult."
    },
    {
      "id": "concrete-urgent-decision",
      "prompt": "A postoperative craniotomy patient just became somnolent with a new fixed pupil. What should I do now?",
      "expected": {
        "route": "consult",
        "response_shape": "action_first",
        "evidence_policy": "proportional",
        "mutation_policy": "read_only",
        "memory_policy": "none"
      },
      "rubric": "Lead with immediate safe priorities and escalation before explanation."
    },
    {
      "id": "single-fact",
      "prompt": "What is the Monro-Kellie doctrine?",
      "expected": {
        "route": "clinical-answer",
        "response_shape": "concise_fact",
        "evidence_policy": "none",
        "mutation_policy": "read_only",
        "memory_policy": "none"
      },
      "rubric": "Answer the single fact directly without forcing a workflow."
    },
    {
      "id": "named-scale",
      "prompt": "Give me the Hunt-Hess grading scale.",
      "expected": {
        "route": "clinical-answer",
        "response_shape": "concise_fact",
        "evidence_policy": "mini_rag",
        "mutation_policy": "read_only",
        "memory_policy": "none"
      },
      "rubric": "Named scales use Mini-RAG rather than a full synthesis retrieval."
    },
    {
      "id": "explicit-study-review",
      "prompt": "Quiz me on my EVD Management note.",
