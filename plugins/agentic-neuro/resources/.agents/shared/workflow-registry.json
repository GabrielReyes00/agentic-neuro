{
  "schema_version": 2,
  "schema": ".agents/shared/workflow-schema.json",
  "authority": {
    "global": "AGENTS.md",
    "workflows": ".agents/shared/commands/",
    "artifact_policy": ".agents/shared/commands/review-artifacts.md",
    "retrieval_policy": ".agents/shared/commands/rag-routing.md",
    "learner_memory": ".agents/shared/commands/memory-operations.md"
  },
  "artifact_defaults": {
    "frontmatter": "native_top_of_file",
    "h1": false,
    "filename": "Title Case without dates, workflow prefixes, or version suffixes",
    "concept_extraction": "novel_only_0_to_5",
    "mastery_rule": "Artifact ownership or generation is never assessed learner mastery"
  },
  "workflows": {
    "anki-maintenance": {
      "title": "Anki Maintenance",
      "description": "Audit or reorganize the live neurosurgery Anki deck with approval before mutation.",
      "argument_hint": "[audit|rewrite|move|deduplicate|rebuild-cache]",
      "contract": ".agents/shared/commands/anki-deck-maintenance.md",
      "vault_destination": null,
      "reviewable": false,
      "generation_recall": "none",
      "write_policy": "export_and_plan_first; live_anki_mutations_require_explicit_approval",
      "anki_policy": "live_anki_is_ground_truth; preserve_review_history",
      "execution": {
        "mode": "approval_gate",
        "run_state": "manifest",
        "entry": "export",
        "nodes": [
          {"id": "export", "kind": "retrieve", "context": "run_scoped", "load": [".agents/shared/commands/anki-deck-maintenance.md"], "edges": [{"to": "assess", "when": "exported"}]},
          {"id": "assess", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/anki-deck-maintenance.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "approval", "when": "plan_ready"}, {"to": "done", "when": "audit_only"}]},
          {"id": "approval", "kind": "approval", "context": "conversation", "load": [".agents/shared/commands/anki-deck-maintenance.md"], "edges": [{"to": "apply", "when": "approved"}, {"to": "done", "when": "declined", "terminal_status": "abandoned"}]},
          {"id": "apply", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/anki-deck-maintenance.md"], "edges": [{"to": "verify", "when": "applied"}]},
          {"id": "verify", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/anki-deck-maintenance.md"], "edges": [{"to": "done", "when": "passed"}, {"to": "apply", "when": "revision_needed", "loop": true}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "consult": {
      "title": "Consult",
      "description": "Answer a bounded bedside task or immediate clinical decision; durable capture is optional.",
      "argument_hint": "[clinical-question-or-task]",
      "contract": ".agents/shared/commands/consult.md",
      "vault_destination": "Consults/<Topic Title>.md",
      "reviewable": true,
      "generation_recall": "evaluated_durable_only",
      "write_policy": "answer_only_by_default; merge_in_place_when_durable_capture_is_requested",
      "anki_policy": "evaluated_exchange_only",
      "execution": {
        "mode": "direct",
        "run_state": "none",
        "entry": "scope",
        "nodes": [
          {"id": "scope", "kind": "intake", "context": "conversation", "load": [".agents/shared/commands/consult.md"], "edges": [{"to": "retrieve", "when": "evidence_needed"}, {"to": "answer", "when": "answer_ready"}]},
          {"id": "retrieve", "kind": "retrieve", "context": "conversation", "load": [".agents/shared/commands/rag-routing.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "answer", "when": "evidence_ready"}]},
          {"id": "answer", "kind": "reason", "context": "conversation", "load": [".agents/shared/commands/consult.md"], "edges": [{"to": "capture", "when": "capture_requested"}, {"to": "review", "when": "review_accepted"}, {"to": "done", "when": "answered"}]},
          {"id": "capture", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/review-artifacts.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "review", "when": "review_accepted"}, {"to": "done", "when": "persisted"}]},
          {"id": "review", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/learning-session-contract.md", ".agents/shared/commands/memory-operations.md", ".agents/shared/commands/adaptive-teaching-doctrine.md", ".agents/shared/commands/anki-session-workflow.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "review", "when": "continue", "loop": true}, {"to": "done", "when": "closed"}]},
          {"id": "done", "kind": "terminal", "context": "conversation", "load": [], "edges": []}
        ]
      }
    },
    "generate-report": {
      "title": "Generate Report",
      "description": "Create a source-traced, citation-dense neurosurgical reference report.",
      "argument_hint": "[topic]",
      "contract": ".agents/shared/commands/generate-report.md",
      "vault_destination": "Reports/<Title>.md",
      "reviewable": true,
      "generation_recall": "none",
      "write_policy": "regenerate_in_place_after_reading_existing",
      "anki_policy": "none_during_generation",
      "execution": {
        "mode": "artifact_graph",
        "run_state": "manifest",
        "entry": "plan",
        "nodes": [
          {"id": "plan", "kind": "intake", "context": "run_scoped", "load": [".agents/shared/commands/generate-report.md", ".agents/shared/commands/generate-report-research-plan.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "research", "when": "planned"}]},
          {"id": "research", "kind": "retrieve", "context": "run_scoped", "load": [".agents/shared/commands/generate-report-research.md", ".agents/shared/commands/rag-routing.md"], "edges": [{"to": "synthesis", "when": "coverage_ready"}]},
          {"id": "synthesis", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/generate-report-synthesis-map.md"], "edges": [{"to": "validate", "when": "drafted"}]},
          {"id": "validate", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/generate-report-finalize.md", ".agents/shared/commands/review-artifacts.md"], "edges": [{"to": "research", "when": "evidence_gap", "loop": true}, {"to": "write", "when": "passed"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/generate-report-finalize.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "done", "when": "installed"}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "grand-rounds": {
      "title": "Grand Rounds",
      "description": "Build and validate an editable neurosurgery case or article presentation package.",
      "argument_hint": "--mode <case|article> [source options]",
      "contract": ".agents/shared/commands/grand-rounds.md",
      "vault_destination": "Presentations/Cases|Articles/<Title>.md",
      "binary_destination": "Presentations/Decks/Cases|Articles/<Title>.pptx",
      "reviewable": true,
      "generation_recall": "none_during_generation; document_for_rehearsal",
      "write_policy": "regenerate_package_in_place_after_source_resolution",
      "anki_policy": "evaluated_rehearsal_only",
      "codex_note": "Use the installed Presentations skill and its artifact-tool workflow; do not author the deck with python-pptx.",
      "codex_ui": {
        "display_name": "Grand Rounds",
        "short_description": "Build validated neurosurgery PowerPoint presentations",
        "default_prompt": "Use $grand-rounds to create a professional editable neurosurgery PowerPoint from my case material or validated Journal Club dossier, including source-traced visuals, speaker notes, package validation, and optional rehearsal."
      },
      "execution": {
        "mode": "artifact_graph",
        "run_state": "manifest",
        "entry": "intake",
        "nodes": [
          {"id": "intake", "kind": "intake", "context": "run_scoped", "load": [".agents/shared/commands/grand-rounds.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "case-evidence", "when": "case"}, {"to": "article-evidence", "when": "article"}]},
          {"id": "case-evidence", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/grand-rounds-case.md"], "edges": [{"to": "deck", "when": "ready"}]},
          {"id": "article-evidence", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/grand-rounds-article.md"], "edges": [{"to": "deck", "when": "ready"}]},
          {"id": "deck", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/grand-rounds-deck.md", ".agents/shared/commands/grand-rounds-visual-design.md"], "edges": [{"to": "validate", "when": "rendered"}]},
          {"id": "validate", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/grand-rounds.md"], "edges": [{"to": "deck", "when": "revision_needed", "loop": true}, {"to": "write", "when": "passed"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/review-artifacts.md"], "edges": [{"to": "rehearsal", "when": "rehearsal_accepted"}, {"to": "done", "when": "installed"}]},
          {"id": "rehearsal", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/grand-rounds-rehearsal.md", ".agents/shared/commands/memory-operations.md", ".agents/shared/commands/memory-retrieval.md", ".agents/shared/commands/adaptive-teaching-doctrine.md", ".agents/shared/commands/anki-session-workflow.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "rehearsal", "when": "continue", "loop": true}, {"to": "done", "when": "closed"}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "inbox-workflow": {
      "title": "Inbox Workflow",
      "description": "Triage email and draft replies with approval before any external mutation.",
      "argument_hint": "[inbox-request]",
      "contract": ".agents/shared/commands/inbox-workflow.md",
      "vault_destination": null,
      "reviewable": false,
      "write_policy": "external_mutations_require_explicit_approval",
      "anki_policy": "none",
      "execution": {
        "mode": "approval_gate",
        "run_state": "none",
        "entry": "triage",
        "nodes": [
          {"id": "triage", "kind": "intake", "context": "conversation", "load": [".agents/shared/commands/inbox-workflow.md"], "edges": [{"to": "draft", "when": "scoped"}]},
          {"id": "draft", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/inbox-workflow.md"], "edges": [{"to": "approval", "when": "draft_ready"}]},
          {"id": "approval", "kind": "approval", "context": "conversation", "load": [".agents/shared/commands/inbox-workflow.md"], "edges": [{"to": "mutate", "when": "approved"}, {"to": "done", "when": "declined"}]},
          {"id": "mutate", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/inbox-workflow.md"], "edges": [{"to": "done", "when": "applied"}]},
          {"id": "done", "kind": "terminal", "context": "conversation", "load": [], "edges": []}
        ]
      }
    },
    "intraoperative-guide": {
      "title": "Intraoperative Guide",
      "description": "Create and independently review a source-grounded operative rehearsal guide.",
      "argument_hint": "[procedure]",
      "contract": ".agents/shared/commands/intraoperative-guide.md",
      "vault_destination": "Operative Guides/<Title>.md",
      "reviewable": true,
      "generation_recall": "optional_topic",
      "write_policy": "regenerate_in_place_after_reading_existing; incomplete_install_requires_explicit_user_approval",
      "anki_policy": "evaluated_exchange_only",
      "execution": {
        "mode": "artifact_graph",
        "run_state": "manifest",
        "entry": "decompose",
        "nodes": [
          {"id": "decompose", "kind": "intake", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide.md", ".agents/shared/commands/intraoperative-guide-decomposition.md"], "edges": [{"to": "research", "when": "mapped"}]},
          {"id": "research", "kind": "retrieve", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide-research.md", ".agents/shared/commands/rag-routing.md"], "edges": [{"to": "knowledge-map", "when": "coverage_ready"}]},
          {"id": "knowledge-map", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide-knowledge-map.md", ".agents/shared/commands/intraoperative-guide-attending-bank.md"], "edges": [{"to": "map-review", "when": "mapped"}]},
          {"id": "map-review", "kind": "validate", "context": "isolated", "load": [".agents/shared/commands/intraoperative-guide-map-review.md"], "edges": [{"to": "gap-repair", "when": "gaps"}, {"to": "crosslinks", "when": "passed"}]},
          {"id": "gap-repair", "kind": "retrieve", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide-gap-repair.md"], "edges": [{"to": "map-review", "when": "repaired", "loop": true}]},
          {"id": "crosslinks", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide-crosslinks.md", ".agents/shared/commands/intraoperative-guide-synthesis.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "independent-review", "when": "drafted"}]},
          {"id": "independent-review", "kind": "validate", "context": "isolated", "load": [".agents/shared/commands/intraoperative-guide-review.md"], "edges": [{"to": "crosslinks", "when": "revision_needed", "loop": true}, {"to": "finalize", "when": "passed"}]},
          {"id": "finalize", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/intraoperative-guide-finalize.md"], "edges": [{"to": "approval", "when": "incomplete"}, {"to": "write", "when": "passed"}]},
          {"id": "approval", "kind": "approval", "context": "conversation", "load": [".agents/shared/commands/intraoperative-guide-finalize.md"], "edges": [{"to": "write", "when": "approved"}, {"to": "done", "when": "declined", "terminal_status": "abandoned"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/review-artifacts.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "done", "when": "installed"}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "journal-club": {
      "title": "Journal Club",
      "description": "Analyze an article into a validated, source-faithful journal-club dossier without slides.",
      "argument_hint": "--pdf <path> [--supplement <path>] [--focus <angle>]",
      "contract": ".agents/shared/commands/journal-club.md",
      "vault_destination": "Journal Club/<Short Article Title>.md",
      "binary_destination": "Journal Club/Sources/<Short Article Title>.pdf",
      "reviewable": true,
      "generation_recall": "none_during_generation; document_for_opted_mastery",
      "write_policy": "regenerate_in_place_after_reading_existing",
      "anki_policy": "evaluated_mastery_only",
      "codex_note": "Use the installed PDF skill for complete text extraction, page rendering, and visual inspection.",
      "codex_ui": {
        "display_name": "Journal Club",
        "short_description": "Master neurosurgery articles for journal club",
        "default_prompt": "Use $journal-club to analyze this neurosurgery article PDF and prepare me to defend it at journal club."
      },
      "execution": {
        "mode": "artifact_graph",
        "run_state": "manifest",
        "entry": "intake",
        "nodes": [
          {"id": "intake", "kind": "intake", "context": "run_scoped", "load": [".agents/shared/commands/journal-club.md"], "edges": [{"to": "analysis", "when": "source_ready"}]},
          {"id": "analysis", "kind": "reason", "context": "run_scoped", "load": [".agents/shared/commands/journal-club-analysis.md", ".agents/shared/commands/rag-routing.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "artifact", "when": "appraised"}]},
          {"id": "artifact", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/journal-club-artifact.md"], "edges": [{"to": "validate", "when": "drafted"}]},
          {"id": "validate", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/journal-club.md"], "edges": [{"to": "artifact", "when": "revision_needed", "loop": true}, {"to": "write", "when": "passed"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/review-artifacts.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "mastery", "when": "mastery_accepted"}, {"to": "done", "when": "installed"}]},
          {"id": "mastery", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/journal-club-artifact.md", ".agents/shared/commands/learning-session-contract.md", ".agents/shared/commands/memory-operations.md", ".agents/shared/commands/memory-retrieval.md", ".agents/shared/commands/adaptive-teaching-doctrine.md", ".agents/shared/commands/anki-session-workflow.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "mastery", "when": "continue", "loop": true}, {"to": "done", "when": "closed"}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "memory-maintenance": {
      "title": "Memory Maintenance",
      "description": "Audit learner-memory identity, telemetry, graph, and database health; apply reviewed repairs only with approval.",
      "argument_hint": "[audit|merge-topics|load-reference-graph|maintain|knowledge-map]",
      "contract": ".agents/shared/commands/memory-maintenance.md",
      "vault_destination": null,
      "reviewable": false,
      "generation_recall": "none",
      "write_policy": "audit_only_by_default; learner_memory_mutations_require_explicit_approval",
      "anki_policy": "none",
      "execution": {
        "mode": "approval_gate",
        "run_state": "manifest",
        "entry": "audit",
        "nodes": [
          {"id": "audit", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/memory-maintenance.md", ".agents/shared/commands/memory-curation.md"], "edges": [{"to": "approval", "when": "repair_proposed"}, {"to": "done", "when": "audit_complete"}]},
          {"id": "approval", "kind": "approval", "context": "conversation", "load": [".agents/shared/commands/memory-maintenance.md"], "edges": [{"to": "apply", "when": "approved"}, {"to": "done", "when": "declined", "terminal_status": "abandoned"}]},
          {"id": "apply", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/memory-maintenance.md"], "edges": [{"to": "verify", "when": "applied"}]},
          {"id": "verify", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/memory-maintenance.md"], "edges": [{"to": "done", "when": "passed"}, {"to": "apply", "when": "revision_needed", "loop": true}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "refactor-manual-note": {
      "title": "Refactor Manual Note",
      "description": "Refactor a manual Obsidian note in place with optional answering, expansion, verification, distillation, and visualization.",
      "argument_hint": "[note-path] [answer] [expand] [verify] [distill] [visualize] [audience=...] [depth=...] [focus=...]",
      "contract": ".agents/shared/commands/refactor-manual-note.md",
      "vault_destination": "existing_source_path",
      "binary_destination": "z_Images/<Descriptive Visual Name>.<ext>",
      "reviewable": true,
      "generation_recall": "none",
      "write_policy": "explicit_in_place_rewrite; preserve_existing_content_and_attachments",
      "anki_policy": "none",
      "execution": {
        "mode": "direct",
        "run_state": "none",
        "entry": "intake",
        "nodes": [
          {"id": "intake", "kind": "intake", "context": "conversation", "load": [".agents/shared/commands/refactor-manual-note.md"], "edges": [{"to": "augment", "when": "augmentation_selected"}, {"to": "rewrite", "when": "refactor_only"}]},
          {"id": "augment", "kind": "reason", "context": "conversation", "load": [".agents/shared/commands/refactor-manual-note-augmentation.md", ".agents/shared/commands/rag-routing.md"], "edges": [{"to": "rewrite", "when": "integrated"}]},
          {"id": "rewrite", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/refactor-manual-note.md"], "edges": [{"to": "visualize", "when": "visual_requested"}, {"to": "validate", "when": "rewritten"}]},
          {"id": "visualize", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/refactor-manual-note-visualize.md"], "edges": [{"to": "validate", "when": "integrated"}]},
          {"id": "validate", "kind": "validate", "context": "conversation", "load": [".agents/shared/commands/refactor-manual-note.md"], "edges": [{"to": "rewrite", "when": "revision_needed", "loop": true}, {"to": "done", "when": "passed"}]},
          {"id": "done", "kind": "terminal", "context": "conversation", "load": [], "edges": []}
        ]
      }
    },
    "service-log": {
      "title": "Service Log",
      "description": "Alias a service-rotation debrief to the Shift Debrief workflow.",
