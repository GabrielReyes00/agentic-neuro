          {"id": "validate", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/shift-debrief.md"], "edges": [{"to": "synthesize", "when": "revision_needed", "loop": true}, {"to": "write", "when": "passed"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/review-artifacts.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "review", "when": "review_accepted"}, {"to": "done", "when": "installed"}]},
          {"id": "review", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/learning-session-contract.md", ".agents/shared/commands/memory-operations.md", ".agents/shared/commands/memory-retrieval.md", ".agents/shared/commands/adaptive-teaching-doctrine.md", ".agents/shared/commands/anki-session-workflow.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "review", "when": "continue", "loop": true}, {"to": "done", "when": "closed"}]},
          {"id": "done", "kind": "terminal", "context": "run_scoped", "load": [], "edges": []}
        ]
      }
    },
    "study-material": {
      "title": "Study Material",
      "description": "Generate validated study material from a source or drill an existing note.",
      "argument_hint": "[source-file-or-study-request]",
      "contract": ".agents/shared/commands/study-material.md",
      "vault_destination": "Study Material/<Title>.md",
      "binary_destination": "Study Material/Sources/<Title>.<ext>",
      "reviewable": true,
      "generation_recall": "optional_topic_then_document_after_install",
      "write_policy": "regenerate_in_place_after_reading_existing",
      "anki_policy": "evaluated_drill_only",
      "execution": {
