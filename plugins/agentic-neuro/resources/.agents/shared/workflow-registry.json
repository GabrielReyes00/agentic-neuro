        "run_state": "manifest",
        "entry": "intake",
        "nodes": [
          {"id": "intake", "kind": "intake", "context": "conversation", "load": [".agents/shared/commands/study-material.md"], "edges": [{"to": "generate", "when": "generate"}, {"to": "drill", "when": "drill"}]},
          {"id": "generate", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/study-material.md", ".agents/shared/commands/rag-routing.md", ".agents/shared/commands/vault-intelligence.md"], "edges": [{"to": "validate", "when": "drafted"}]},
          {"id": "validate", "kind": "validate", "context": "run_scoped", "load": [".agents/shared/commands/study-material.md"], "edges": [{"to": "generate", "when": "revision_needed", "loop": true}, {"to": "write", "when": "passed"}]},
          {"id": "write", "kind": "write", "context": "run_scoped", "load": [".agents/shared/commands/review-artifacts.md", ".agents/shared/commands/concept-extraction.md"], "edges": [{"to": "done", "when": "installed"}]},
          {"id": "drill", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/study-material.md", ".agents/shared/commands/learning-session-contract.md", ".agents/shared/commands/memory-operations.md", ".agents/shared/commands/memory-retrieval.md", ".agents/shared/commands/adaptive-teaching-doctrine.md", ".agents/shared/commands/anki-session-workflow.md", ".agents/shared/commands/anki-card-quality.md"], "edges": [{"to": "drill", "when": "continue", "loop": true}, {"to": "done", "when": "complete"}]},
          {"id": "done", "kind": "terminal", "context": "conversation", "load": [], "edges": []}
        ]
      }
    },
    "study-review": {
      "title": "Study Review",
      "description": "Run memory-enabled Socratic review from a vault document or weak-spot queue.",
      "argument_hint": "[topic-or-document-or-review-request]",
      "contract": ".agents/shared/commands/study-review-startup.md",
      "modules": [
        ".agents/shared/commands/study-review-turn.md",
        ".agents/shared/commands/study-review-vault-repair.md",
        ".agents/shared/commands/study-review-end.md"
      ],
      "vault_destination": null,
      "reviewable": false,
      "write_policy": "learner_memory_only",
      "anki_policy": "evaluated_exchange_only",
      "execution": {
        "mode": "conversation_loop",
