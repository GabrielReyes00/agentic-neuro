        "nodes": [
          {"id": "startup", "kind": "intake", "context": "conversation", "load": [".agents/shared/commands/study-review-startup.md", ".agents/shared/commands/tutor-state.md"], "edges": [{"to": "turn", "when": "question_asked"}]},
          {"id": "turn", "kind": "loop", "context": "conversation", "load": [".agents/shared/commands/study-review-turn.md", ".agents/shared/commands/adaptive-teaching-doctrine.md"], "edges": [{"to": "turn", "when": "continue", "loop": true}, {"to": "vault-repair", "when": "vault_repair_needed"}, {"to": "end", "when": "end_requested"}]},
          {"id": "vault-repair", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/study-review-vault-repair.md"], "edges": [{"to": "turn", "when": "repaired", "loop": true}]},
          {"id": "end", "kind": "write", "context": "conversation", "load": [".agents/shared/commands/study-review-end.md", ".agents/shared/commands/anki-session-workflow.md"], "edges": [{"to": "done", "when": "closed"}]},
          {"id": "done", "kind": "terminal", "context": "conversation", "load": [], "edges": []}
        ]
      }
    }
  }
